+import { afterEach, describe, expect, it, vi } from 'vitest'
+import { createRouter, createMemoryHistory } from 'vue-router'
+
+afterEach(() => {
+  document.querySelectorAll('base').forEach(node => node.remove())
+  vi.unstubAllEnvs()
+  vi.resetModules()
+})
+
+describe('runtime deployment base', () => {
+  it.each(['/', '/s2a/', '/tools/ai/'])('uses %s for routes, resources and API calls', async (prefix) => {
+    const tag = document.createElement('base')
+    tag.setAttribute('href', prefix)
+    document.head.prepend(tag)
+    vi.stubEnv('VITE_API_BASE_URL', '')
+    vi.resetModules()
+    const base = await import('@/utils/appBase')
+    const urls = await import('../url')
+    const markers = await import('../adminUIRequest')
+    const mount = prefix.replace(/\/+$/, '')
+    expect(base.getAppBase()).toBe(mount || '/')
+    expect(base.appPath('/login?next=%2Fadmin')).toBe(`${mount}/login?next=%2Fadmin`)
+    expect(base.appPath(`${mount}/login`)).toBe(`${mount}/login`)
+    expect(base.appPath('/logo.svg')).toBe(`${mount}/logo.svg`)
+    expect(base.appPath('https://oauth.example/callback')).toBe('https://oauth.example/callback')
+    expect(base.appPath('//cdn.example/logo.svg')).toBe('//cdn.example/logo.svg')
+    expect(base.appOrigin()).toBe(`${window.location.origin}${mount}`)
+    expect(urls.buildApiUrl('/auth/me?mode=test')).toBe(`${mount}/api/v1/auth/me?mode=test`)
+    expect(urls.buildApiUrl('/api/v1/admin/users')).toBe(`${mount}/api/v1/admin/users`)
+    expect(new URL(urls.buildGatewayUrl('/setup/status')).pathname).toBe(`${mount}/setup/status`)
+    expect(new URL(urls.buildGatewayUrl('/v1/responses')).pathname).toBe(`${mount}/v1/responses`)
+    expect(new URL(urls.buildGatewayUrl('/api/v1/admin/ops/ws/qps')).pathname).toBe(`${mount}/api/v1/admin/ops/ws/qps`)
+    expect(markers.shouldMarkAdminUIRequest(`${mount}/api/v1/admin/users`, `${mount}/admin/users`)).toBe(true)
+    expect(markers.shouldMarkAdminUIRequest(`${mount}/api/v1/auth/me`, `${mount}/dashboard`)).toBe(false)
+    expect(markers.shouldMarkUserUIRequest(`${mount}/api/v1/keys`)).toBe(true)
+    const router = createRouter({ history: createMemoryHistory(base.getAppBase()), routes: [{ path: '/login', component: {} }] })
+    expect(router.resolve('/login').href).toBe(`${mount}/login`)
+  })
+
+  it('keeps an explicitly configured external API origin', async () => {
+    vi.stubEnv('VITE_API_BASE_URL', 'https://api.example.test/api/v1')
+    vi.resetModules()
+    const urls = await import('../url')
+    expect(urls.buildApiUrl('/auth/me')).toBe('https://api.example.test/api/v1/auth/me')
+  })
+})
