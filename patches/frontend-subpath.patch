+/** Public mount path supplied by the server's runtime <base> tag. */
+const configuredBase = typeof document === 'undefined' ? '' : document.querySelector('base')?.getAttribute('href') || ''
+const appBase = configuredBase.startsWith('/') && !configuredBase.startsWith('//') ? configuredBase.replace(/\/+$/, '') : ''
+
+export function getAppBase(): string {
+  return appBase || '/'
+}
+export function appPath(path: string): string {
+  if (!appBase || !path.startsWith('/') || path.startsWith('//') || path === appBase || path.startsWith(`${appBase}/`)) return path
+  return `${appBase}${path}`
+}
+export function stripAppBase(path: string): string {
+  return appBase && (path === appBase || path.startsWith(`${appBase}/`)) ? path.slice(appBase.length) || '/' : path
+}
+export function appOrigin(): string {
+  return `${window.location.origin}${appBase}`
+}
