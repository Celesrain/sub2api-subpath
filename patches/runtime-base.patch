+//go:build embed
+
+package web
+
+import (
+	"errors"
+	"net/http/httptest"
+	"strings"
+	"testing"
+
+	"github.com/gin-gonic/gin"
+)
+
+func TestFrontendRuntimeBase(t *testing.T) {
+	t.Setenv("APP_BASE_PATH", "/tools/ai/")
+	provider := &mockSettingsProvider{settings: map[string]string{"site_logo": "/logo.svg"}}
+	server, err := NewFrontendServer(provider)
+	if err != nil {
+		t.Fatal(err)
+	}
+	for _, fallback := range []bool{false, false, true} {
+		if fallback {
+			server.InvalidateCache()
+			provider.err = errors.New("synthetic settings failure")
+		}
+		w := httptest.NewRecorder()
+		c, _ := gin.CreateTestContext(w)
+		c.Request = httptest.NewRequest("GET", "/admin/dashboard", nil)
+		server.serveIndexHTML(c)
+		body := w.Body.String()
+		if w.Code != 200 || !strings.Contains(body, `<base href="/tools/ai/">`) {
+			t.Fatalf("runtime base missing, status %d", w.Code)
+		}
+		if !fallback && !strings.Contains(body, `href="/tools/ai/logo.svg"`) {
+			t.Fatal("custom local favicon lost its mount prefix")
+		}
+	}
+}
+
+func TestFrontendRejectsInvalidRuntimeBase(t *testing.T) {
+	t.Setenv("APP_BASE_PATH", "//untrusted.test/")
+	if _, err := NewFrontendServer(&mockSettingsProvider{}); err == nil {
+		t.Fatal("invalid APP_BASE_PATH was accepted")
+	}
+}
+
+func TestLegacyFrontendRuntimeBase(t *testing.T) {
+	t.Setenv("APP_BASE_PATH", "/tools/ai/")
+	for _, path := range []string{"/", "/index.html", "/login"} {
+		w := httptest.NewRecorder()
+		c, _ := gin.CreateTestContext(w)
+		c.Request = httptest.NewRequest("GET", path, nil)
+		ServeEmbeddedFrontend()(c)
+		if w.Code != 200 || !strings.Contains(w.Body.String(), `<base href="/tools/ai/">`) {
+			t.Fatalf("legacy route %s lost runtime base", path)
+		}
+	}
+}
