+package web
+
+import (
+	"bytes"
+	"fmt"
+	"regexp"
+	"strings"
+)
+
+var appBaseSegment = regexp.MustCompile(`^[A-Za-z0-9_~-][A-Za-z0-9._~-]*$`)
+
+// normalizeAppBase accepts a same-origin mount path, never a URL or dot segment.
+func normalizeAppBase(value string) (string, error) {
+	value = strings.TrimSpace(value)
+	if value == "" || value == "/" {
+		return "/", nil
+	}
+	invalid := fmt.Errorf("APP_BASE_PATH must be / or an absolute path of URL-safe segments")
+	if !strings.HasPrefix(value, "/") {
+		return "", invalid
+	}
+	value = strings.TrimSuffix(value, "/")
+	for _, segment := range strings.Split(value[1:], "/") {
+		if !appBaseSegment.MatchString(segment) {
+			return "", invalid
+		}
+	}
+	return value + "/", nil
+}
+
+// injectAppBase runs before caching and branding, so deep links and fallback HTML agree.
+func injectAppBase(content []byte, base string) []byte {
+	return bytes.Replace(content, []byte("<head>"), []byte(`<head><base href="`+base+`">`), 1)
+}
+
+func appBaseLocalURL(value, base string) string {
+	prefix := strings.TrimSuffix(base, "/")
+	if prefix == "" || !strings.HasPrefix(value, "/") || strings.HasPrefix(value, "//") || value == prefix || strings.HasPrefix(value, prefix+"/") {
+		return value
+	}
+	return prefix + value
+}
