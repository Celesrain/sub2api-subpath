@@ -0,0 +1,36 @@
+package web
+
+import (
+	"bytes"
+	"testing"
+)
+
+func TestNormalizeAppBase(t *testing.T) {
+	for value, want := range map[string]string{"": "/", "/": "/", "/s2a": "/s2a/", "/tools/ai/": "/tools/ai/", "/v1.2/_app": "/v1.2/_app/"} {
+		got, err := normalizeAppBase(value)
+		if err != nil || got != want {
+			t.Fatalf("%q: got %q, %v", value, got, err)
+		}
+	}
+	for _, value := range []string{"relative", "//evil.test", "/a//b", "/a/../b", "/a/./b", "/a?x=1", "/a#b", "/a%2fb", "/a\\b", "/a\"b", "/a/\nb"} {
+		if _, err := normalizeAppBase(value); err == nil {
+			t.Errorf("accepted invalid mount %q", value)
+		}
+	}
+}
+
+func TestInjectAppBase(t *testing.T) {
+	html := []byte(`<html><head><script src="./assets/main.js"></script></head></html>`)
+	result := injectAppBase(html, "/tools/ai/")
+	if !bytes.Contains(result, []byte(`<head><base href="/tools/ai/"><script`)) {
+		t.Fatal(string(result))
+	}
+}
+
+func TestAppBaseLocalURL(t *testing.T) {
+	for value, want := range map[string]string{"/logo.svg": "/tools/ai/logo.svg", "/tools/ai/logo.svg": "/tools/ai/logo.svg", "https://cdn.test/logo.svg": "https://cdn.test/logo.svg", "//cdn.test/logo.svg": "//cdn.test/logo.svg", "data:image/svg+xml,abc": "data:image/svg+xml,abc"} {
+		if got := appBaseLocalURL(value, "/tools/ai/"); got != want {
+			t.Errorf("%q -> %q, want %q", value, got, want)
+		}
+	}
+}
