# Copy .env.template to .env and set permissions to 0600.
# Based on the deployed configuration keys; all live credentials have been removed.
# Replace every REPLACE_WITH_* value before deployment.
# Generate JWT_SECRET and TOTP_ENCRYPTION_KEY independently with: openssl rand -hex 32

# Server and runtime
BIND_HOST=127.0.0.1
SERVER_PORT=20080
SERVER_MODE=release
RUN_MODE=standard
TZ=Asia/Tokyo

# Database
POSTGRES_USER=sub2api
POSTGRES_PASSWORD=REPLACE_WITH_DATABASE_PASSWORD
POSTGRES_DB=sub2api
POSTGRES_MAX_CONNECTIONS=60
POSTGRES_SHARED_BUFFERS=64MB
POSTGRES_EFFECTIVE_CACHE_SIZE=256MB
POSTGRES_MAINTENANCE_WORK_MEM=16MB
DATABASE_MAX_OPEN_CONNS=20
DATABASE_MAX_IDLE_CONNS=5

# Redis
REDIS_PASSWORD=REPLACE_WITH_REDIS_PASSWORD
REDIS_DB=0
REDIS_POOL_SIZE=100
REDIS_MIN_IDLE_CONNS=5
REDIS_MAXCLIENTS=1000

# Initial administrator
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=REPLACE_WITH_ADMIN_PASSWORD

# Authentication and encryption
JWT_SECRET=REPLACE_WITH_RANDOM_JWT_SECRET
JWT_EXPIRE_HOUR=24
TOTP_ENCRYPTION_KEY=REPLACE_WITH_64_HEX_CHARACTERS

# Logging
LOG_LEVEL=info
LOG_FORMAT=json
LOG_OUTPUT_TO_STDOUT=true
LOG_OUTPUT_TO_FILE=true
LOG_ROTATION_MAX_SIZE_MB=100
LOG_ROTATION_MAX_BACKUPS=10
LOG_ROTATION_MAX_AGE_DAYS=7

# Upstream URL policy
SECURITY_URL_ALLOWLIST_ENABLED=true
SECURITY_URL_ALLOWLIST_ALLOW_INSECURE_HTTP=true
SECURITY_URL_ALLOWLIST_ALLOW_PRIVATE_HOSTS=true

# Optional update proxy
UPDATE_PROXY_URL=

# Image and public mount path
SUB2API_SUBPATH_IMAGE=ghcr.io/suzuira01/sub2api-subpath:0.2.17-subpath.2
APP_BASE_PATH=/s2a/
